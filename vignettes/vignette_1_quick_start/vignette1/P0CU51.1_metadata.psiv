rator":"simple","locationStatus":"supported","locationVersion":1,"qualifiers":{"region_name":"Region of interest in the sequence","note":"\"CAHS motif 2.","evidence":"ECO:0000250|UniProtKB:J7M799.\""},"featureId":"P0CU51.1:feature:8"},{"featureType":"Region","featureClass":"region","label":"Region of interest in the sequence","locationText":"202..229","start":202,"end":229,"segments":[{"start":202,"end":229}],"locationOperator":"simple","locationStatus":"supported","locationVersion":1,"qualifiers":{"region_name":"Region of interest in the sequence","note":"Disordered. /evidence=ECO:0000256|SAM:MobiDB-lite."},"featureId":"P0CU51.1:feature:9"},{"featureType":"Region","featureClass":"region","label":"Compositionally biased region","locationText":"202..218","start":202,"end":218,"segments":[{"start":202,"end":218}],"locationOperator":"simple","locationStatus":"supported","locationVersion":1,"qualifiers":{"region_name":"Compositionally biased region","note":"\"Polar residues.","evidence":"ECO:0000256|SAM:MobiDB-lite.\""},"featureId":"P0CU51.1:feature:10"},{"featureType":"Region","featureClass":"region","label":"Compositionally biased region","locationText":"219..229","start":219,"end":229,"segments":[{"start":219,"end":229}],"locationOperator":"simple","locationStatus":"supported","locationVersion":1,"qualifiers":{"region_name":"Compositionally biased region","note":"\"Basic and acidic residues.","evidence":"ECO:0000256|SAM:MobiDB-lite.\""},"featureId":"P0CU51.1:feature:11"}],"sites":[],"otherFeatures":[],"featureSummary":{"total":11,"sources":1,"genes":1,"proteins":1,"regions":8,"sites":0,"otherFeatures":0}},"rawText":"LOCUS       CAHS1_PARRC              229 aa            linear   INV 05-FEB-2025\nDEFINITION  RecName: Full=Cytosolic-abundant heat soluble protein 107838;\n            Short=CAHS 107838; AltName: Full=Tardigrade-specific intrinsically\n            disordered protein CAHS 107838; Short=TDP CAHS 107838.\nACCESSION   P0CU51\nVERSION     P0CU51.1\nDBSOURCE    UniProtKB: locus CAHS1_PARRC, accession P0CU51;\n            class: standard.\n            created: Jun 7, 2017.\n            sequence updated: Jun 7, 2017.\n            annotation updated: Feb 5, 2025.\n            xrefs (non-sequence databases): AlphaFoldDB:P0CU51, SMR:P0CU51,\n            GO:0005737, GO:0009269, DisProt:DP01383\nKEYWORDS    Coiled coil; Cytoplasm; Repeat; Stress response.\nSOURCE      Paramacrobiotus richtersi\n  ORGANISM  Paramacrobiotus richtersi\n            Eukaryota; Metazoa; Ecdysozoa; Tardigrada; Eutardigrada; Parachela;\n            Macrobiotoidea; Macrobiotidae; Paramacrobiotus; Paramacrobiotus\n            richtersi group.\nREFERENCE   1  (residues 1 to 229)\n  AUTHORS   Boothby,T.C., Tapia,H., Brozena,A.H., Piszkiewicz,S., Smith,A.E.,\n            Giovannini,I., Rebecchi,L., Pielak,G.J., Koshland,D. and\n            Goldstein,B.\n  TITLE     Tardigrades Use Intrinsically Disordered Proteins to Survive\n            Desiccation\n  JOURNAL   Mol Cell 65 (6), 975-984 (2017)\n   PUBMED   28306513\n  REMARK    FUNCTION.\nREFERENCE   2  (residues 1 to 229)\n  AUTHORS   Arakawa,K. and Numata,K.\n  TITLE     Reconsidering the 'glass transition' hypothesis of intrinsically\n            unstructured CAHS proteins in desiccation tolerance of tardigrades\n  JOURNAL   Mol Cell 81 (3), 409-410 (2021)\n   PUBMED   33545053\n  REMARK    FUNCTION.\nCOMMENT     [FUNCTION] CAHS proteins are cytosolic heat soluble proteins that\n            seem to contribute to the anhydrobiosis in tardigrades, but their\n            specific mechanisms are yet to be identified (PubMed:28306513,\n            PubMed:33545053). It is possible that protection during\n            anhydrobiosis might occur via the stabilization of vitrifying small\n            molecules such as sugars, but not via the direct glass transition\n            of CAHS proteins themselves (Probable).\n            {ECO:0000269|PubMed:28306513, ECO:0000269|PubMed:33545053,\n            ECO:0000305|PubMed:33545053}.\n            [SUBCELLULAR LOCATION] Cytoplasm {ECO:0000305|PubMed:28306513}.\n            [DOMAIN] CAHS proteins contain 2 repeats of 19-mer peptides\n            designated as CAHS-motifs that comprise each two octapeptides\n            connected by a tripeptide (By similarity).\n            {ECO:0000250|UniProtKB:J7M799}.\n            [MISCELLANEOUS] Trehalose, a disaccharide essential for several\n            organisms to survive drying, is detected at low levels or not at\n            all in some tardigrade species, indicating that tardigrades possess\n            potentially novel mechanisms for surviving desiccation involving\n            tardigrade-specific intrinsically disordered proteins (TDPs)\n            (PubMed:28306513). {ECO:0000269|PubMed:28306513}.\n            [SIMILARITY] Belongs to the Cytosolic-abundant heat soluble protein\n            (CAHS) family. {ECO:0000305}.\n            [CAUTION] It was suggested that CAHS proteins were intrinsically\n            unstructured and show heat-dependent glass transition, which\n            contributes to the vitrification of cells, and this further leads\n            to desiccation tolerance (PubMed:28306513). However, more recent\n            studies led to the conclusion that there was no evidence supporting\n            glass transition of CAHS proteins to be contributing to the glass\n            transition of the whole tardigrade (PubMed:33545053).\n            {ECO:0000269|PubMed:28306513, ECO:0000269|PubMed:33545053}.\nFEATURES             Location/Qualifiers\n     source          1..229\n                     /organism=\"Paramacrobiotus richtersi\"\n                     /db_xref=\"taxon:697321\"\n     gene            1..229\n                     /gene=\"CAHS 107838\"\n     Protein         1..229\n                     /product=\"Cytosolic-abundant heat soluble protein 107838\"\n                     /note=\"CAHS 107838; Tardigrade-specific intrinsically\n                     disordered protein CAHS 107838; TDP CAHS 107838\"\n                     /UniProtKB_evidence=\"Inferred from homology\"\n     Region          1..229\n                     /region_name=\"Mature chain\"\n                     /note=\"Cytosolic-abundant heat soluble protein 107838.\n                     /id=PRO_0000440198.\"\n     Region          1..29\n                     /region_name=\"Region of interest in the sequence\"\n                     /note=\"Disordered. /evidence=ECO:0000256|SAM:MobiDB-lite.\"\n     Region          109..145\n                     /region_name=\"Coiled-coil region\"\n                     /note=\"/evidence=ECO:0000255.\"\n     Region          124..142\n                     /region_name=\"Region of interest in the sequence\"\n                     /note=\"CAHS motif 1.\n                     /evidence=ECO:0000250|UniProtKB:J7M799.\"\n     Region          161..179\n                     /region_name=\"Region of interest in the sequence\"\n                     /note=\"CAHS motif 2.\n                     /evidence=ECO:0000250|UniProtKB:J7M799.\"\n     Region          202..229\n                     /region_name=\"Region of interest in the sequence\"\n                     /note=\"Disordered. /evidence=ECO:0000256|SAM:MobiDB-lite.\"\n     Region          202..218\n                     /region_name=\"Compositionally biased region\"\n                     /note=\"Polar residues.\n                     /evidence=ECO:0000256|SAM:MobiDB-lite.\"\n     Region          219..229\n                     /region_name=\"Compositionally biased region\"\n                     /note=\"Basic and acidic residues.\n                     /evidence=ECO:0000256|SAM:MobiDB-lite.\"\nORIGIN      \n        1 msaeamnmnm nqdavfippp egeqyerkek qeiqqtsylq sqvkvplvnl papffstsfs\n       61 aqeilgegfq asisrisavs eelssieipe laeearrdfa aktreqemls anyqkeverk\n      121 teayrkqqev eadkirkele kqhlrdvefr kdivemaien qkkmidvesr yakkdmdrer\n      181 vkvrmmleqq kfhsdiqvnl dssaagtetg gqvvsesqkf ternrqikq\n//","f