onally biased region\"\n                     /note=\"Low complexity.\n                     /evidence=ECO:0000256|SAM:MobiDB-lite.\"\n     Region          216..237\n                     /region_name=\"Compositionally biased region\"\n                     /note=\"Basic and acidic residues.\n                     /evidence=ECO:0000256|SAM:MobiDB-lite.\"\nORIGIN      \n        1 msqqyekkve rtevvyggdr rvegsasasa ekttnythte irapmvnplp piistgaagl\n       61 aqeivgegft asatrisgaa attqvlesqa sreqafkdqe kysreqasia rahdkdlekk\n      121 teeyrktaea eaekirkele kqhardvefr kdlvesaidr qkrevdleak yakkeleher\n      181 elamnaleqs kmatnvqvqm dtaagttvsg gttvsehtev hdgkekkslg ekikslf\n//","fileName":"NCBI EFetch GenPept","recordIndex":25,"importedAt":"2026-11-02T16:29:24.735Z","sourceOrigin":{"type":"ncbi_efetch_genpept","name":"NCBI EFetch GenPept"}},"P0CU46":{"accession":"P0CU46","accessionVersion":"P0CU46.2","locus":"CAHS2_HYPEX 237 aa linear INV 02-SEP-2026","definition":"RecName: Full=Cytosolic-abundant heat soluble protein 86272; Short=CAHS 86272; AltName: Full=Cytosolic-abundant heat soluble protein b; Short=SAHS-b; AltName: Full=Tardigrade-specific intrinsically disordered protein CAHS 86272; Short=TDP CAHS 86272.","sourceName":"Hypsibius exemplaris","organism":"Hypsibius exemplaris","lineage":["Eukaryota","Metazoa","Ecdysozoa","Tardigrada","Eutardigrada","Parachela","Hypsibioidea","Hypsibiidae","Hypsibius"],"taxid":"2072580","sequenceLength":237,"sequence":"MSQQYEKKVERTEVVYGGDRRVEGSASASAEKTTNYTHTEIRAPMVNPLPPIISTGAAGLAQEIVGEGFTASATRISGAAATTQVLESQASREQAFKDQEKYSREQASIARAHDKDLEKKTEEYRKTAEAEAEKIRKELEKQHARDVEFRKDLVESAIDRQKREVDLEAKYAKKELEHERELAMNALEQSKMATNVQVQMDTAAGTTVSGGTTVSEHTEVHDGKEKKSLGEKIKSLF","annotations":{"manualQueryRange":null,"sources":[{"featureType":"source","featureClass":"source","label":"Hypsibius exemplaris","locationText":"1..237","start":1,"end":237,"segments":[{"start":1,"end":237}],"locationOperator":"simple","locationStatus":"supported","locationVersion":1,"qualif